{
  "name": "@wisihe/portfolio-sveltekit",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write ."
  },
  "devDependencies": {
    "@portabletext/svelte": "^2.1.11",
    "@portabletext/types": "^2.0.13",
    "@sanity/types": "^3.61.0",
    "@sveltejs/adapter-auto": "^3.2.5",
    "@sveltejs/kit": "^2.7.2",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@wisihe/constants": "workspace:*",
    "@wisihe/tailwind-config": "workspace:*",
    "@wisihe/utils": "workspace:*",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte3": "^4.0.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "svelte": "5.0.0-next.260",
    "svelte-check": "^4.0.5",
    "svelte-typewriter": "^3.2.3",
    "tailwindcss": "^3.4.14",
    "tslib": "^2.8.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "tabWidth": 2
  },
  "type": "module",
  "engines": {
    "node": ">= 14.18"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/oswald": "^5.1.0",
    "@sanity/client": "^6.22.2",
    "@sanity/image-url": "^1.0.2",
    "@sanity/svelte-loader": "^1.11.37",
    "@sanity/visual-editing": "^2.1.10",
    "@tabler/icons-svelte": "^3.19.0",
    "@tine/designsystem-utils": "1.1.0",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "groq": "^3.61.0",
    "gsap": "^3.12.5",
    "openai": "^4.68.1",
    "svelte-icons-pack": "^3.1.3",
    "tailwind-merge": "^2.5.4"
  }
}
