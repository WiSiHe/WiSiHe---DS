{
  "name": "@wisihe/portfolio-sveltekit",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --plugin-search-dir . --check . && eslint .",
    "format": "prettier --plugin-search-dir . --write ."
  },
  "devDependencies": {
    "@portabletext/svelte": "^2.1.11",
    "@portabletext/types": "^2.0.13",
    "@sanity/client": "^6.21.1",
    "@sanity/image-url": "^1.0.2",
    "@sanity/types": "^3.52.2",
    "@sveltejs/adapter-auto": "^3.2.2",
    "@sveltejs/kit": "^2.5.18",
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@wisihe/constants": "workspace:*",
    "@wisihe/tailwind-config": "workspace:*",
    "@wisihe/utils": "workspace:*",
    "autoprefixer": "^10.4.19",
    "clsx": "^2.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte3": "^4.0.0",
    "groq": "^3.52.2",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.6",
    "svelte": "^4.2.18",
    "svelte-check": "^3.8.4",
    "svelte-typewriter": "^3.2.3",
    "tailwindcss": "^3.4.7",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "tabWidth": 2
  },
  "type": "module",
  "engines": {
    "node": ">= 14.18"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.19",
    "@fontsource-variable/oswald": "^5.0.20",
    "@tabler/icons-svelte": "^3.11.0",
    "@vercel/analytics": "^1.3.1",
    "svelte-icons-pack": "^3.1.3"
  }
}
