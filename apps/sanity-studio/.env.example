# Copy to `.env.local` for local Studio dev and `pnpm deploy:local`, or inject via Doppler (see docs/env-variables.md).
# Minimum for CLI deploy without Doppler:
#   SANITY_STUDIO_PROJECT_ID=<same as NEXT_PUBLIC_SANITY_PROJECT_ID in nextjs-portfolio>
# Never commit real secrets.

# =============================================================================
# Sanity project (required)
# =============================================================================
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Live preview / Presentation tool — your Next.js site URL
SANITY_STUDIO_PREVIEW_URL=https://www.wisihe.no

# Server-side read token for GROQ scripts (sync-algolia, migrations). Not public.
SANITY_API_READ_TOKEN=

# One-off write scripts (--apply). Editor or deploy token with write access.
# SANITY_API_WRITE_TOKEN=

# =============================================================================
# Algolia — index sync & settings scripts
# =============================================================================
ALGOLIA_APP_ID=
ALGOLIA_WRITE_KEY=
ALGOLIA_INDEX_NAME=wisihe-search

# =============================================================================
# OpenAI — Studio Assist / bulk AI (required for `pnpm deploy:studio` schema deploy)
# =============================================================================
OPENAI_API_KEY=

# =============================================================================
# AI proxy (must match SANITY_AI_PROXY_SECRET on nextjs-portfolio)
# =============================================================================
# SANITY_AI_BULK_SECRET is deprecated — use SANITY_AI_PROXY_SECRET on Next.js instead.
