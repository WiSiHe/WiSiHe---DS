# Copy to `.env.local` for local Studio dev, or inject via Doppler (see docs/doppler-setup.md).
# Never commit real secrets.
#
# Studio loads `.env` files automatically. Scripts (sync-algolia, etc.) read the same vars.

# =============================================================================
# Sanity project (required)
# =============================================================================
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Live preview / Presentation tool — your Next.js site URL
SANITY_STUDIO_PREVIEW_URL=https://www.wisihe.no

# Used by `sanity deploy` / CLI (often same as PROJECT_ID / DATASET)
SANITY_STUDIO_API_PROJECT_ID=
SANITY_STUDIO_API_DATASET=production

# Server-side read token for GROQ scripts (sync-algolia, migrations). Not public.
SANITY_API_READ_TOKEN=

# =============================================================================
# Algolia — index sync & settings scripts
# =============================================================================
ALGOLIA_APP_ID=
ALGOLIA_WRITE_KEY=
ALGOLIA_INDEX_NAME=wisihe-search

# Sanity Blueprint function: set to "true" to auto-sync on publish (optional)
# ALGOLIA_ENABLE_AUTO_SYNC=false

# =============================================================================
# Sanity Assist / bulk AI in Studio
# =============================================================================
# SANITY_STUDIO_OPENAI_API_KEY=

# Must match SANITY_AI_BULK_SECRET in nextjs-portfolio when using the AI proxy route
# SANITY_AI_BULK_SECRET=
