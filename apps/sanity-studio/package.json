{
  "name": "sanity-studio",
  "private": true,
  "version": "1.1.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "doppler run -- sanity dev",
    "dev:local": "sanity dev",
    "start": "doppler run -- sanity start",
    "start:local": "sanity start",
    "prebuild": "npm run extract-types",
    "build": "sanity build",
    "deploy": "doppler run --project portfolio --config prd -- sh scripts/deploy-studio.sh",
    "deploy:local": "sh scripts/deploy-studio.sh",
    "extract-types": "sanity schema extract --enforce-required-fields",
    "typegen": "sanity typegen generate",
    "sync-algolia": "doppler run -- tsx scripts/sync-algolia.ts",
    "sync-algolia:local": "tsx scripts/sync-algolia.ts",
    "sync-algolia:prd": "doppler run --config prd -- tsx scripts/sync-algolia.ts",
    "set-algolia-settings": "doppler run -- tsx scripts/set-algolia-settings.ts",
    "set-algolia-settings:local": "tsx scripts/set-algolia-settings.ts",
    "set-algolia-settings:prd": "doppler run --config prd -- tsx scripts/set-algolia-settings.ts",
    "migrate-ingredients": "sanity exec migrations/migrate-ingredients.ts --with-user-token",
    "bulk-generate-photos": "sanity exec migrations/bulk-generate-photos.ts --with-user-token",
    "test-openai": "sanity exec migrations/test-openai.ts --with-user-token"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/assist": "^6.3.0",
    "@sanity/blueprints": "0.34.1",
    "@sanity/cli": "^8.28.2",
    "@sanity/client": "catalog:",
    "@sanity/code-input": "7.3.16",
    "@sanity/document-internationalization": "^6.3.0",
    "@sanity/functions": "1.11.0",
    "@sanity/icons": "^5.3.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/ui": "^4.4.12",
    "@sanity/vision": "^6.23.0",
    "algoliasearch": "catalog:",
    "openai": "^7.30.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-icons": "^5.7.0",
    "sanity": "catalog:",
    "sanity-plugin-media": "^6.3.3",
    "styled-components": "^6.5.3"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "devDependencies": {
    "@csstools/css-calc": "^3.4.3",
    "@types/node": "26.6.6",
    "@types/react": "catalog:",
    "@wisihe/typescript-config": "workspace:*",
    "dotenv": "18.0.6",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  }
}
