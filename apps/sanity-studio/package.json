{
  "name": "sanity-studio",
  "private": true,
  "version": "1.1.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "prebuild": "npm run extract-types",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "extract-types": "sanity schema extract --enforce-required-fields",
    "typegen": "sanity typegen generate",
    "sync-algolia": "tsx scripts/sync-algolia.ts",
    "set-algolia-settings": "tsx scripts/set-algolia-settings.ts",
    "migrate-ingredients": "sanity exec migrations/migrate-ingredients.ts --with-user-token",
    "bulk-generate-photos": "sanity exec migrations/bulk-generate-photos.ts --with-user-token",
    "test-openai": "sanity exec migrations/test-openai.ts --with-user-token"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/assist": "^6.1.0",
    "@sanity/blueprints": "0.20.1",
    "@sanity/cli": "^7.2.3",
    "@sanity/client": "^7.22.1",
    "@sanity/code-input": "7.1.2",
    "@sanity/document-internationalization": "^6.2.9",
    "@sanity/functions": "1.3.1",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/studio-secrets": "^4.0.3",
    "@sanity/ui": "^3.2.0",
    "@sanity/vision": "^6.2.0",
    "algoliasearch": "5.52.1",
    "openai": "^6.38.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-is": "^19.2.6",
    "sanity": "^6.2.0",
    "sanity-plugin-media": "^4.3.0",
    "styled-components": "^6.4.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/react": "^19.2.15",
    "@wisihe/typescript-config": "workspace:*",
    "dotenv": "17.4.2",
    "tsx": "4.22.3",
    "typescript": "^6.0.3"
  }
}
