{
  "extends": "@wisihe/typescript-config/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": [".storybook/**/*.ts", "src/**/*.ts", "src/**/*.vue"],
  "exclude": ["node_modules", "storybook-static"]
}
