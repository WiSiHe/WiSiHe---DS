# TanStack Start portfolio — environment variables
# Copy to `.env.local` and fill in values.

# Sanity (required)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-10-28

# Sanity preview / draft mode (server-side read token with Viewer permissions)
# Used by `/api/draft-mode/enable` and previewDrafts perspective when preview cookie is set.
VITE_SANITY_API_READ_TOKEN=
# Alias supported by the app:
# VITE_SANITY_PREVIEW_TOKEN=

# Optional: Sanity write token (engagement counters, etc.)
VITE_SANITY_WRITE_TOKEN=

# Algolia (paintings search)
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_KEY=
VITE_ALGOLIA_INDEX_NAME=wisihe-search

# Mapbox (photography map)
VITE_MAPBOX_TOKEN=

# PostHog analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
