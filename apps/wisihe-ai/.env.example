# Copy to `.env.local` for local dev (never commit real secrets).
# Full naming reference: ../../docs/env-variables.md
#
# Sanity App SDK: SANITY_APP_* vars are injected by the CLI into the browser bundle.

# --- Content Lake (same values as SANITY_STUDIO_* / NEXT_PUBLIC_SANITY_*) ---
SANITY_APP_PROJECT_ID=ns25bkom
SANITY_APP_DATASET=production

# --- AI proxy (Next.js /api/wisihe-ai/suggest-tags) ---
SANITY_APP_AI_PROXY_URL=http://localhost:1992
SANITY_APP_AI_PROXY_SECRET=

# Legacy VITE_* fallbacks (optional)
# VITE_SANITY_PROJECT_ID=
# VITE_SANITY_DATASET=
# VITE_AI_PROXY_URL=
# VITE_AI_PROXY_SECRET=

# --- Deploy (`pnpm deploy:wisihe-ai`) ---
# SANITY_AUTH_TOKEN=
