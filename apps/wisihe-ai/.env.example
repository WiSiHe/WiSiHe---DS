# Copy to `.env.local` for local dev (never commit real secrets).
# Doppler + monorepo env guide: ../../docs/doppler-setup.md
#
# Sanity App SDK: variables prefixed with SANITY_APP_ are picked up by the CLI and
# exposed as process.env in the browser bundle. See:
# https://www.sanity.io/docs/app-sdk/sdk-configuration#environment-variables

# --- Content Lake (same values as SANITY_STUDIO_PROJECT_ID / SANITY_STUDIO_DATASET in apps/sanity-studio) ---
SANITY_APP_PROJECT_ID=ns25bkom
SANITY_APP_DATASET=production

# --- AI proxy (Next.js app hosting /api/wisihe-ai/suggest-tags) ---
SANITY_APP_AI_PROXY_URL=http://localhost:1992
SANITY_APP_AI_PROXY_SECRET=

# Legacy VITE_* fallbacks (optional if you use SANITY_APP_* above)
# VITE_SANITY_PROJECT_ID=
# VITE_SANITY_DATASET=
# VITE_AI_PROXY_URL=
# VITE_AI_PROXY_SECRET=

# --- Deploy this app (`pnpm deploy` / GitHub Actions) ---
# Organization robot token with "Manage SDK Apps" (not used in the browser bundle).
# https://www.sanity.io/docs/app-sdk/sdk-deployment
# SANITY_AUTH_TOKEN=
