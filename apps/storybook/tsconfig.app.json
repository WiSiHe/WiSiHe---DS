{
  "extends": "@wisihe/typescript-config/storybook.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@wisihe/ui-react": ["../../packages/ui-react/src"],
      "@wisihe/ui-react/*": ["../../packages/ui-react/src/*"],
      "@wisihe/tokens": ["../../packages/tokens"],
      "@wisihe/tokens/*": ["../../packages/tokens/*"],
      "@wisihe/utils": ["../../packages/utils/src"],
      "@wisihe/utils/*": ["../../packages/utils/src/*"]
    }
  },
  "include": ["src", ".storybook"]
}
