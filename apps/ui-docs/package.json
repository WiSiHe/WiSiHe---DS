    "storybook:fresh": "pnpm run storybook:clean && pnpm run storybook",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@wisihe/tokens": "workspace:*",
    "@wisihe/ui-react": "workspace:*",
    "motion": "catalog:",
