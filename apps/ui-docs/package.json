{
  "name": "ui-docs",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @wisihe/tokens build",
    "prestorybook": "pnpm --filter @wisihe/tokens build",
    "dev": "storybook dev -p 6006 --no-open",
    "build": "tsc -b && storybook build",
    "preview": "vite preview",
