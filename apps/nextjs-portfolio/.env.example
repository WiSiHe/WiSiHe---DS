# Copy to `.env.local` for local dev, or inject via Doppler (see docs/doppler-setup.md).
# Never commit real secrets.
#
# Next.js inlines NEXT_PUBLIC_* at build time — restart `pnpm dev` after changes.
# On Vercel, set these in Doppler (synced) or Project → Environment Variables.

# =============================================================================
# Sanity CMS (required)
# =============================================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-08-22
NEXT_PUBLIC_SANITY_STUDIO_URL=https://wisihe.sanity.studio/

# Viewer token — exposed to the browser bundle (read-only, use minimal permissions).
NEXT_PUBLIC_SANITY_API_READ_TOKEN=

# Optional — only if client-side mutations need it (prefer server actions instead).
# NEXT_PUBLIC_SANITY_API_WRITE_TOKEN=

# =============================================================================
# Algolia search (required for /paintings gallery)
# =============================================================================
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=wisihe-search

# =============================================================================
# Analytics — privacy-first PostHog (recommended)
# Enable "Cookieless server hash mode" in PostHog → Project Settings → Web analytics.
# =============================================================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =============================================================================
# Contact form — Resend (optional locally; required in production for form email)
# =============================================================================
RESEND_API_KEY=
CONTACT_TO_EMAIL=hws902@gmail.com
# Verified sender in Resend, e.g. WiSiHe Contact <contact@wisihe.no>
CONTACT_FROM_EMAIL=WiSiHe Contact <onboarding@resend.dev>

# =============================================================================
# Optional features
# =============================================================================

# About page life-journey map (Mapbox GL)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# YouTube video metadata on /videos
# YOUTUBE_API_KEY=

# Statsig / Vercel Flags experimentation (scaffold only — not required for the live site)
# EXPERIMENTATION_CONFIG_ITEM_KEY=
# STATSIG_SERVER_API_KEY=
# NEXT_PUBLIC_STATSIG_CLIENT_KEY=

# =============================================================================
# AI tag suggestions API (/api/wisihe-ai/suggest-tags) — used by Sanity Studio
# =============================================================================
# OPENAI_API_KEY=
# OPENAI_TAG_SUGGEST_MODEL=gpt-5.4-nano
# SANITY_AI_BULK_SECRET=
# SANITY_AI_BULK_ALLOWED_ORIGINS=https://wisihe.sanity.studio,http://localhost:3333
