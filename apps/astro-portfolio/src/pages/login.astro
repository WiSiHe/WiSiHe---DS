---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { adminAuth } from "../lib/firebase/server";

// If already logged in, redirect to paintings
if (Astro.cookies.has("session")) {
    const sessionCookie = Astro.cookies.get("session")?.value || "";
    try {
        const decodedCookie =
            await adminAuth.verifySessionCookie(sessionCookie);
        if (decodedCookie) {
            return Astro.redirect("/paintings");
        }
    } catch (err) {
        // Cookie is invalid, ignore and show login form
    }
}
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title="Login | WiSiHe" description="Admin Login" />
        <style>
            .login-container {
                display: flex;
                flex-direction: column;
                align-items: center;
                margin-top: 4rem;
                min-height: 50vh;
            }
            form {
                display: flex;
                flex-direction: column;
                gap: 1rem;
                width: 100%;
                max-width: 400px;
                background: #f9f9f9;
                padding: 2rem;
                border-radius: 8px;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            }
            input {
                padding: 0.75rem;
                border: 1px solid #ccc;
                border-radius: 4px;
                font-size: 1rem;
            }
            button {
                padding: 0.75rem;
                background: #222;
                color: white;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-size: 1rem;
                font-weight: bold;
            }
            button:hover {
                background: #444;
            }
            .error {
                color: red;
                font-size: 0.875rem;
                text-align: center;
                display: none;
            }
        </style>
    </head>
    <body>
        <Header />
        <main class="login-container">
            <h1>Admin Login</h1>
            <form id="login-form">
                <p class="error" id="error-message"></p>
                <input
                    type="email"
                    id="email"
                    placeholder="Email Address"
                    required
                />
                <input
                    type="password"
                    id="password"
                    placeholder="Password"
                    required
                />
                <button type="submit" id="submit-btn">Login</button>
            </form>
        </main>
        <Footer />

        <script>
            import { auth } from "../lib/firebase/client";
            import { signInWithEmailAndPassword } from "firebase/auth";

            const form = document.getElementById(
                "login-form",
            ) as HTMLFormElement;
            const errorMsg = document.getElementById(
                "error-message",
            ) as HTMLParagraphElement;
            const submitBtn = document.getElementById(
                "submit-btn",
            ) as HTMLButtonElement;

            form.addEventListener("submit", async (e) => {
                e.preventDefault();
                errorMsg.style.display = "none";
                submitBtn.disabled = true;
                submitBtn.textContent = "Logging in...";

                const email = (
                    document.getElementById("email") as HTMLInputElement
                ).value;
                const password = (
                    document.getElementById("password") as HTMLInputElement
                ).value;

                try {
                    // 1. Log in with Firebase Client SDK
                    const userCredential = await signInWithEmailAndPassword(
                        auth,
                        email,
                        password,
                    );
                    const idToken = await userCredential.user.getIdToken();

                    // 2. Send ID Token to our server to create a session cookie
                    const res = await fetch("/api/auth/signin", {
                        method: "POST",
                        headers: {
                            Authorization: `Bearer ${idToken}`,
                        },
                    });

                    if (res.redirected) {
                        window.location.assign(res.url);
                    } else if (res.ok) {
                        window.location.href = "/paintings";
                    } else {
                        throw new Error("Failed to create session on server");
                    }
                } catch (error: any) {
                    console.error(error);
                    errorMsg.textContent =
                        error.message || "Invalid login credentials";
                    errorMsg.style.display = "block";
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.textContent = "Login";
                }
            });
        </script>
    </body>
</html>
