{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "group:monorepos"
  ],
  "timezone": "Europe/Oslo",
  "schedule": ["before 5am on Monday"],
  "prHourlyLimit": 1,
  "prConcurrentLimit": 5,
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "bump",
  "postUpdateOptions": ["pnpmDedupe"],
  "labels": ["dependencies", "renovate"],
  "constraints": {
    "node": ">=24.0.0"
  },
  "ignorePaths": ["**/node_modules/**", "**/dist/**", "**/build/**"],
  "ignoreDeps": ["lefthook"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "description": "Major updates: one grouped PR, first Monday-ish of the month, for manual review.",
      "matchUpdateTypes": ["major"],
      "groupName": "major updates",
      "groupSlug": "major",
      "schedule": ["before 5am on the first day of the month"]
    },
    {
      "description": "Require manual review; do not automerge dependency PRs.",
      "matchUpdateTypes": ["patch", "minor", "pin", "digest"],
      "automerge": false
    },
    {
      "description": "Weekly catch-all for ungrouped patch/minor updates. Ecosystem rules below override this.",
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "all other dependencies",
      "groupSlug": "all-other"
    },
    {
      "description": "Root monorepo tooling.",
      "matchPaths": ["package.json"],
      "matchPackageNames": ["turbo", "@biomejs/biome", "@changesets/cli", "knip"],
      "groupName": "monorepo tooling",
      "groupSlug": "monorepo-tooling"
    },
    {
      "description": "Node.js in engines, .node-version, and GitHub Actions.",
      "matchManagers": ["nvm", "nodenv", "node-version", "github-actions"],
      "matchPackageNames": ["node"],
      "groupName": "Node.js",
      "groupSlug": "node"
    },
    {
      "description": "Group React ecosystem updates.",
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackageNames": ["react", "react-dom"],
      "groupName": "React dependencies",
      "groupSlug": "react"
    },
    {
      "description": "Group Vue ecosystem updates.",
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackageNames": ["vue", "vue-tsc"],
      "matchPackagePatterns": ["^@vue/"],
      "groupName": "Vue dependencies",
      "groupSlug": "vue"
    },
    {
      "description": "Group Svelte ecosystem updates.",
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackageNames": ["svelte", "svelte-check", "@sveltejs/package"],
      "matchPackagePatterns": ["^@sveltejs/"],
      "groupName": "Svelte dependencies",
      "groupSlug": "svelte"
    },
    {
      "description": "Group Vite ecosystem updates.",
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackageNames": ["vite"],
      "matchPackagePatterns": ["^@vitejs/"],
      "groupName": "Vite dependencies",
      "groupSlug": "vite"
    },
    {
      "description": "Group Astro ecosystem updates.",
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackageNames": ["astro"],
      "matchPackagePatterns": ["^@astrojs/"],
      "groupName": "Astro dependencies",
      "groupSlug": "astro"
    },
    {
      "description": "Group Next.js ecosystem updates.",
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackageNames": ["next", "eslint-config-next"],
      "groupName": "Next.js dependencies",
      "groupSlug": "nextjs"
    },
    {
      "description": "Group Sanity ecosystem updates.",
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackageNames": ["sanity", "next-sanity"],
      "matchPackagePatterns": ["^@sanity/"],
      "groupName": "Sanity dependencies",
      "groupSlug": "sanity"
    },
    {
      "description": "Group Biome ecosystem updates.",
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackagePatterns": ["^@biomejs/"],
      "groupName": "Biome dependencies",
      "groupSlug": "biome"
    },
    {
      "description": "Group TypeScript DefinitelyTyped updates.",
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackagePatterns": ["^@types/"],
      "groupName": "TypeScript types",
      "groupSlug": "types"
    },
    {
      "description": "Group Storybook ecosystem updates.",
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackagePatterns": ["^@storybook/", "^storybook"],
      "groupName": "Storybook dependencies",
      "groupSlug": "storybook"
    },
    {
      "description": "Group TanStack ecosystem updates.",
      "matchUpdateTypes": ["patch", "minor"],
      "matchPackagePatterns": ["^@tanstack/"],
      "groupName": "TanStack dependencies",
      "groupSlug": "tanstack"
    }
  ]
}
