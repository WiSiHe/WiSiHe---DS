{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "EXPERIMENTATION_CONFIG_ITEM_KEY",
        "STATSIG_SERVER_API_KEY",
        "NEXT_PUBLIC_ALGOLIA_APP_ID",
        "NEXT_PUBLIC_ALGOLIA_SEARCH_KEY",
        "NEXT_PUBLIC_ALGOLIA_INDEX_NAME"
      ]
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build-storybook": {
      "dependsOn": [],
      "outputs": ["storybook-static/**"]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_*",
    "PUBLIC_*",
    "VITE_*",
    "EXPERIMENTATION_CONFIG_ITEM_KEY",
    "STATSIG_SERVER_API_KEY",
    "PUBLIC_OPENAI_API_KEY",
    "OPENAI_API_KEY",
    "FIREBASE_PROJECT_ID",
    "FIREBASE_CLIENT_EMAIL",
    "FIREBASE_PRIVATE_KEY"
  ],
  "globalPassThroughEnv": [
    "SANITY_AI_PROXY_SECRET",
    "SANITY_AI_BULK_SECRET",
    "SANITY_STUDIO_*",
    "SANITY_APP_*",
    "DOPPLER_*",
    "OPENAI_*",
    "SANITY_API_*",
    "SANITY_AUTH_TOKEN",
    "SANITY_CLI_MODE",
    "ALGOLIA_*",
    "POSTHOG_*",
    "SITE_HEALTH_*",
    "GITHUB_REPOSITORY",
    "GITHUB_TOKEN",
    "YOUTUBE_API_KEY",
    "ISR_BYPASS_TOKEN"
  ]
}
