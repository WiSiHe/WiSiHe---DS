{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": ["./biome.json"],
  "linter": {
    "rules": {
      "correctness": {
        "noInvalidUseBeforeDeclaration": "error",
        "useHookAtTopLevel": "error",
        "noInvalidPositionAtImportRule": "error"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error"
      }
    }
  }
}
