{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/nextjs-portfolio": {
      "entry": ["app/**/*.{ts,tsx}", "sanity/**/*.ts", "utils/**/*.ts", "hooks/**/*.ts"]
    },
    "apps/sanity-studio": {
      "entry": [
        "components/**/*.tsx",
        "schemas/**/*.{ts,tsx}",
        "scripts/**/*.{ts,mjs}",
        "migrations/**/*.ts",
        "functions/**/*.ts",
        "gen-schema.ts",
        "generate-schema.mjs"
      ],
      "ignore": ["generate-schema.mjs"]
    },
    "apps/ui-docs": {
      "entry": ["src/**/*.{ts,tsx}", ".storybook/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@storybook/react", "playwright", "postcss", "motion"]
    },
    "apps/wisihe-ai": {
      "entry": ["src/App.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@sanity/sdk", "@sanity/workflow-blueprint", "rolldown", "prettier"]
    },
    "tools/site-health": {
      "ignoreDependencies": ["chrome-launcher", "lighthouse"]
    },
    ".": {
      "entry": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["@sanity/client", "dotenv", "lighthouse", "@csstools/css-calc"]
    },
    "packages/ui-react": {
      "entry": ["src/**/*.stories.tsx"],
      "ignoreDependencies": ["@wisihe/utils", "@storybook/react", "@storybook/react-vite"]
    },
    "packages/tokens": {
      "entry": ["scripts/**/*.js"]
    }
  },
  "ignore": ["**/*.config.{js,ts,mjs}", "**/sanity.types.ts"],
  "ignoreBinaries": ["doppler", "vercel"]
}
