{
  "private": true,
  "name": "@wisihe/ds",
  "type": "module",
  "scripts": {
    "build:packages": "turbo run build --filter=./packages/*",
    "build": "turbo run build --filter=!sanity-studio --filter=!ui-docs --filter=!ui-svelte-docs --filter=!ui-vue-docs --filter=!ui-web-components-docs",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:packages",
    "dev": "turbo run dev --filter=nextjs-portfolio... --filter=ui-docs...",
    "dev:studio": "turbo run dev --filter=sanity-studio...",
    "dev:astro": "turbo run dev --filter=apps-astro-portfolio...",
    "dev:react": "turbo run dev --filter=@wisihe/ui-react... --filter=ui-docs...",
    "dev:angular": "turbo run dev --filter=@wisihe/ui-angular...",
    "dev:vue": "turbo run dev --filter=@wisihe/ui-vue... --filter=ui-vue-docs...",
    "dev:svelte": "turbo run dev --filter=@wisihe/ui-svelte... --filter=ui-svelte-docs...",
    "dev:web-components": "turbo run dev --filter=@wisihe/ui-web-components... --filter=ui-web-components-docs...",
    "dev:all": "turbo run dev --concurrency=20",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=@wisihe/ui-angular --filter=@wisihe/ui-vue --filter=@wisihe/ui-web-components",
    "storybook": "turbo run storybook --filter=ui-docs --filter=ui-svelte-docs --filter=ui-vue-docs --filter=ui-web-components-docs",
    "build-storybook": "turbo run build-storybook --filter=ui-docs --filter=ui-svelte-docs --filter=ui-vue-docs --filter=ui-web-components-docs",
    "clean": "turbo run clean && rm -rf node_modules",
    "purge": "turbo run clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && rm -f pnpm-lock.yaml",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "knip": "5.70.2",
    "lefthook": "1.13.6",
    "prettier": "^3.8.1",
    "turbo": "^2.7.6"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vercel/speed-insights",
      "lefthook",
      "sharp"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "sanity": "4",
        "eslint": "9"
      },
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    },
    "allowedDeprecatedVersions": {
      "eslint-plugin-markdown": "*",
      "glob": "8.1.0",
      "inflight": "*",
      "source-map": "0.8.0-beta.0"
    }
  }
}
