{
  "private": true,
  "name": "@wisihe/ds",
  "type": "module",
  "scripts": {
    "build:packages": "turbo run build --filter=./packages/*",
    "build": "turbo run build --filter=!sanity-studio --filter=!ui-docs",
    "ci": "pnpm lint:ci && pnpm typecheck && pnpm test && pnpm build:packages",
    "doppler:setup": "doppler setup --project portfolio --config dev",
    "dev": "doppler run -- turbo run dev --filter=nextjs-portfolio... --filter=ui-docs... --filter=sanity-studio... --filter=wisihe-ai",
    "dev:local": "turbo run dev --filter=nextjs-portfolio... --filter=ui-docs... --filter=sanity-studio... --filter=wisihe-ai",
    "dev:studio": "doppler run -- turbo run dev --filter=sanity-studio...",
    "dev:studio:local": "turbo run dev --filter=sanity-studio...",
    "dev:wisihe-ai": "doppler run -- turbo run dev --filter=wisihe-ai --filter=nextjs-portfolio...",
    "dev:wisihe-ai:local": "turbo run dev --filter=wisihe-ai --filter=nextjs-portfolio...",
    "deploy:wisihe-ai": "doppler run -- pnpm --filter wisihe-ai exec sanity deploy",
    "deploy:studio": "pnpm --filter sanity-studio run deploy",
    "sync-algolia": "doppler run --config prd -- pnpm --filter sanity-studio exec tsx scripts/sync-algolia.ts",
    "sync-algolia:dev": "doppler run --config dev -- pnpm --filter sanity-studio exec tsx scripts/sync-algolia.ts",
    "set-algolia-settings": "doppler run --config prd -- pnpm --filter sanity-studio set-algolia-settings",
    "env:pull": "vercel env pull apps/nextjs-portfolio/.env.local --environment=development",
    "dev:react": "turbo run dev --filter=@wisihe/ui-react... --filter=ui-docs...",
    "dev:all": "turbo run dev --concurrency=20",
    "lint": "biome check .",
    "lint:ci": "biome ci --config-path=biome.ci.json .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "turbo run storybook --filter=ui-docs",
    "build-storybook": "turbo run build-storybook --filter=ui-docs",
    "clean": "turbo run clean && rm -rf node_modules",
    "purge": "turbo run clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && rm -f pnpm-lock.yaml",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish",
    "site-health:weekly": "node scripts/weekly-site-health.mjs",
    "site-health:weekly:dry-run": "node scripts/weekly-site-health.mjs --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "knip": "6.40.0",
    "lefthook": "2.2.1",
    "turbo": "^2.11.7"
  },
  "packageManager": "pnpm@12.10.1"
}
