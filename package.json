{
  "private": true,
  "name": "@wisihe/ds",
  "type": "module",
  "scripts": {
    "build:packages": "turbo run build --filter=./packages/*",
    "build": "turbo run build --filter=!sanity-studio --filter=!ui-docs --filter=!ui-svelte-docs --filter=!ui-web-components-docs",
    "ci": "pnpm lint:ci && pnpm typecheck && pnpm test && pnpm build:packages",
    "dev": "turbo run dev --filter=nextjs-portfolio... --filter=ui-docs... --filter=sanity-studio... --filter=wisihe-ai",
    "dev:studio": "turbo run dev --filter=sanity-studio...",
    "dev:wisihe-ai": "turbo run dev --filter=wisihe-ai",
    "deploy:wisihe-ai": "pnpm --filter wisihe-ai exec sanity deploy",
    "dev:astro": "turbo run dev --filter=apps-astro-portfolio...",
    "dev:react": "turbo run dev --filter=@wisihe/ui-react... --filter=ui-docs...",
    "dev:svelte": "turbo run dev --filter=@wisihe/ui-svelte... --filter=ui-svelte-docs...",
    "dev:web-components": "turbo run dev --filter=@wisihe/ui-web-components... --filter=ui-web-components-docs...",
    "dev:all": "turbo run dev --concurrency=20",
    "lint": "biome check .",
    "lint:ci": "biome ci --config-path=biome.ci.json .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=@wisihe/ui-web-components",
    "storybook": "turbo run storybook --filter=ui-docs --filter=ui-svelte-docs --filter=ui-web-components-docs",
    "build-storybook": "turbo run build-storybook --filter=ui-docs --filter=ui-svelte-docs --filter=ui-web-components-docs",
    "clean": "turbo run clean && rm -rf node_modules",
    "purge": "turbo run clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && rm -f pnpm-lock.yaml",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.31.0",
    "knip": "6.14.1",
    "lefthook": "2.1.8",
    "turbo": "^2.9.14"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "patchedDependencies": {
      "sanity@6.0.0": "patches/sanity@6.0.0.patch"
    },
    "overrides": {
      "@types/node": "25.3.5"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@vercel/speed-insights",
      "core-js",
      "esbuild",
      "lefthook",
      "less",
      "msw",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "sanity": "6"
      },
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    },
    "allowedDeprecatedVersions": {
      "glob": "8.1.0",
      "inflight": "*",
      "source-map": "0.8.0-beta.0"
    }
  }
}
