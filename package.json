{
  "private": true,
  "name": "@wisihe/ds",
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=!sanity-studio --filter=!ui-docs",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "purge": "turbo run clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && rm -f pnpm-lock.yaml",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=docs^... && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "knip": "5.70.2",
    "lefthook": "1.13.6",
    "prettier": "^3.7.4",
    "turbo": "^2.6.3"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook",
      "@vercel/speed-insights",
      "sharp"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "sanity": "4",
        "eslint": "9"
      },
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    },
    "allowedDeprecatedVersions": {
      "eslint-plugin-markdown": "*",
      "glob": "8.1.0",
      "inflight": "*",
      "source-map": "0.8.0-beta.0"
    }
  }
}
