{
  "name": "@wisihe/ui-react",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@wisihe/eslint-config": "workspace:*",
    "@wisihe/typescript-config": "workspace:*",
    "@wisihe/utils": "workspace:*",
    "eslint": "^9.35.0",
    "framer-motion": "^11.18.2",
    "react": "^19.1.1",
    "tailwindcss": "^4.1.13",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@wisihe/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
