{
  "name": "@wisihe/ui-react",
  "version": "1.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "source": "./src/index.tsx",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**",
    "src/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "predev": "pnpm --filter @wisihe/tokens build",
    "dev": "tsup --watch",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@wisihe/typescript-config": "workspace:*",
    "@wisihe/utils": "workspace:*",
    "react": "^19.2.6",
    "tailwindcss": "^4.3.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@tabler/icons-react": "^3.44.0",
    "@wisihe/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "motion": "^12.42.0"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.19"
  }
}
