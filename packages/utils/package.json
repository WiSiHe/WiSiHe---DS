{
  "name": "@wisihe/utils",
  "version": "1.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "source": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**",
    "src/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@wisihe/typescript-config": "workspace:*",
    "clsx": "catalog:",
    "tailwind-merge": "^3.6.0",
    "tsup": "catalog:",
    "typescript": "catalog:tsup"
  },
  "publishConfig": {
    "access": "public"
  }
}
