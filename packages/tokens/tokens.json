{
  "dimension": {
    "scale": {
      "$value": "2",
      "$type": "dimension"
    },
    "xs": {
      "$value": "4",
      "$type": "dimension"
    },
    "sm": {
      "$value": "{dimension.xs} * {dimension.scale}",
      "$type": "dimension"
    },
    "md": {
      "$value": "{dimension.sm} * {dimension.scale}",
      "$type": "dimension"
    },
    "lg": {
      "$value": "{dimension.md} * {dimension.scale}",
      "$type": "dimension"
    },
    "xl": {
      "$value": "{dimension.lg} * {dimension.scale}",
      "$type": "dimension"
    }
  },
  "spacing": {
    "xs": {
      "$value": "{dimension.xs}",
      "$type": "spacing"
    },
    "sm": {
      "$value": "{dimension.sm}",
      "$type": "spacing"
    },
    "md": {
      "$value": "{dimension.md}",
      "$type": "spacing"
    },
    "lg": {
      "$value": "{dimension.lg}",
      "$type": "spacing"
    },
    "xl": {
      "$value": "{dimension.xl}",
      "$type": "spacing"
    },
    "multi-value": {
      "$value": "{dimension.sm} {dimension.xl}",
      "$type": "spacing",
      "$description": "You can have multiple values in a single spacing token. Read more on these: https://docs.tokens.studio/available-tokens/spacing-tokens#multi-value-spacing-tokens"
    }
  },
  "borderRadius": {
    "sm": {
      "$value": "4",
      "$type": "borderRadius"
    },
    "lg": {
      "$value": "8",
