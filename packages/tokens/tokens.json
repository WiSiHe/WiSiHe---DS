{
  "dimension": {
    "scale": {
      "$value": "2",
      "$type": "dimension"
    },
    "xs": {
      "$value": "4",
      "$type": "dimension"
    },
    "sm": {
      "$value": "{dimension.xs} * {dimension.scale}",
