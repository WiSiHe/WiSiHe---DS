{
  "name": "@wisihe/tokens",
  "version": "1.1.0",
  "type": "module",
  "exports": {
    "./css": {
      "style": "./dist/css/variables.css",
      "default": "./dist/css/variables.css"
    },
    "./css/semantic": {
      "style": "./dist/css/semantic-colors.css",
      "default": "./dist/css/semantic-colors.css"
    },
    "./tailwind-v4": {
      "style": "./dist/tailwind/theme.css",
      "default": "./dist/tailwind/theme.css"
    },
    "./tailwind-v4-dark": {
      "style": "./dist/tailwind/theme-dark.css",
      "default": "./dist/tailwind/theme-dark.css"
    },
    "./raw": "./tokens.json"
  },
  "files": [
    "dist",
    "tokens",
    "tokens.json"
  ],
  "scripts": {
    "build": "style-dictionary build --config style-dictionary.config.js --silent && node scripts/build-tailwind-themes.js",
    "test": "node --test tests/*.test.js",
    "clean": "node scripts/clean.js"
  },
  "devDependencies": {
    "style-dictionary": "5.6.0"
  }
}
