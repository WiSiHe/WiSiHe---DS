{
  "source": ["tokens.json"],
  "platforms": {
    "css": {
      "transformGroup": "css",
      "buildPath": "dist/css/",
      "files": [
        {
          "destination": "variables.css",
          "format": "css/variables"
        }
      ]
    },
    "tailwind-v4": {
      "transformGroup": "css",
      "buildPath": "dist/tailwind/",
      "files": [
        {
          "destination": "theme.css",
          "format": "css/tailwind-v4-theme"
        }
      ]
    },
    "tailwind-v3": {
      "transformGroup": "js",
      "buildPath": "dist/tailwind/",
      "files": [
        {
          "destination": "config.js",
          "format": "javascript/module"
        }
      ]
    }
  }
}
