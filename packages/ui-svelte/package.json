{
  "name": "@wisihe/ui-svelte",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "svelte": "./dist/index.js",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**",
    "src/**"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package --input src --output dist",
    "dev": "svelte-package --input src --output dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist && rm -rf .svelte-kit"
  },
  "dependencies": {
    "@wisihe/tokens": "workspace:*",
    "@wisihe/utils": "workspace:*",
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@wisihe/typescript-config": "workspace:*",
    "svelte": "^5.55.9",
    "svelte-check": "^4.4.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "svelte": "^5.53.6",
    "tailwindcss": ">=3.4.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
