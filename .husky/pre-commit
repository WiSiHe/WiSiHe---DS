#!/bin/sh

echo "🔍 Running pre-commit checks..."

# Run type checking
echo "📝 Checking TypeScript types..."
pnpm turbo typecheck || {
  echo "❌ TypeScript type checking failed. Please fix the errors and try again."
  exit 1
}

# Run build check (excluding sanity-studio due to network issues)
echo "🏗️  Checking build..."
pnpm turbo build --filter=!sanity-studio || {
  echo "❌ Build failed. Please fix the errors and try again."
  exit 1
}

# Run lint-staged
echo "🔍 Running lint-staged..."
pnpm lint-staged || {
  echo "❌ Pre-commit checks failed. Please fix the errors and try again."
  exit 1
}

echo "✅ Pre-commit checks passed!"